{
  "name": "azul",
  "version": "1.0.0",
  "description": "A locally-run AI coding assistant with terminal UI",
  "private": false,
  "bin": {
    "azul": "./bin/azul.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:global": "npm run build -w @azul/ui && npm run build -w @azul/server",
    "dev": "npm run build && node packages/server/dist/main.js",
    "watch": "npm run watch --workspaces --if-present",
    "start": "node packages/server/dist/main.js",
    "clean": "rm -rf packages/*/dist",
    "rebuild": "rm -rf packages/*/dist && npm run build --workspaces",
    "install:global": "npm run build:global && npm install -g ."
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "llm",
    "terminal"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "bin",
    "packages/server/dist",
    "packages/server/package.json",
    "packages/ui/dist",
    "packages/ui/package.json",
    "config.json"
  ],
  "dependencies": {
    "ink": "^4.4.1",
    "node-llama-cpp": "^3.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.42",
    "typescript": "^5.3.3"
  }
}
